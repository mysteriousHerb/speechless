#!/usr/bin/env bash
# Dev launcher: API (uvicorn, :8000) + Vite (:5173, proxies /api). Ctrl-C stops both.
# A worktree slot has its own ports in .env.dev (written by the harness); the canonical
# checkout has none and uses the defaults. Explicit API_PORT / WEB_PORT in the environment win.
set -euo pipefail
cd "$(dirname "$0")"
if [ -f .env.dev ]; then
  set -a; . ./.env.dev; set +a
fi
export API_PORT="${API_PORT:-8000}"
export WEB_PORT="${WEB_PORT:-5173}"
trap 'kill 0' EXIT INT TERM
(cd api && uv run fastapi dev src/speechless_api/main.py --host 0.0.0.0 --port "$API_PORT") &
(cd web && [ -d node_modules ] || npm install; npm run dev -- --port "$WEB_PORT" --host) &
wait
