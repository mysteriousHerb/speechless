# Copy to .env (ignored). Never commit real values.

# Which voice the server uses. auto = ElevenLabs if a key is set, else free Microsoft
# Edge voices. Options: auto | elevenlabs | edge | none
TTS_BACKEND=auto

ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=

# Optional overrides
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_v4_turbo
# EDGE_TTS_VOICE=en-US-AriaNeural      # list: cd api && uv run edge-tts --list-voices

# Quick replies (M1). Server-side only. Easiest: set ANTHROPIC_API_KEY above and leave
# the LLM_* block empty; the server then uses Claude (LLM_MODEL defaults to claude-haiku-5-5).
# Alternatively any OpenAI-compatible chat-completions endpoint; setting LLM_BASE_URL
# selects it. Azure AI Foundry example:
#   LLM_BASE_URL=https://<resource>.openai.azure.com/openai/v1
#   LLM_MODEL=<your deployment name, e.g. gpt-6-luna>
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# "none" switches reasoning off for speed (Claude: thinking disabled; gpt-6-luna:
# reasoning_effort=none). Claude also accepts low | medium | high.
LLM_REASONING_EFFORT=none
